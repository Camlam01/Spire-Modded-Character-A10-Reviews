# Copy this file to .env.local and fill in each value. Never commit .env.local.

# The address the site runs at. Steam sends players back here after sign-in.
# Local: http://localhost:3000   Production: https://your-site.vercel.app
SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret "service_role" key. Server-only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Steam Web API key from https://steamcommunity.com/dev/apikey
# Used to read a player's name and avatar, and whether they own STS2.
STEAM_API_KEY=

# A long random string that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Slay the Spire 2's Steam app id. Workshop links for other games are rejected.
STS2_APP_ID=2868840

# Who may post reviews: anyone | owners | verified
#   owners   - blocks players Steam shows as not owning STS2; private game lists are allowed
#   verified - only players whose public game list shows STS2
REVIEW_OWNERSHIP=owners

# Comma-separated SteamID64s allowed to remove mods and reviews.
ADMIN_STEAM_IDS=
