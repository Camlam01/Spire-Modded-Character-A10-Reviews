# Settings for running the site on your computer. The easy way: run `npm run setup`, which writes .env.local for you.
# Or copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel, add these under Settings → Environment Variables instead (see SETUP.md).

# Supabase → Project Settings → API. On Vercel, the Supabase connection adds these for you.
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret "service_role" key. Server-only: never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Steam Web API key from https://steamcommunity.com/dev/apikey
# Used to read a player's name and avatar, and whether they own STS2.
STEAM_API_KEY=

# Comma-separated SteamID64s allowed to remove mods, reviews and comments, and fix character links.
ADMIN_STEAM_IDS=

# --- Optional: everything below has a default ---

# The site's address. Defaults to http://localhost:3000 locally; on Vercel the site detects its own address.
# Only needed for a custom domain on a host other than Vercel.
# SITE_URL=

# Signs login cookies. When unset, one is derived from SUPABASE_SERVICE_ROLE_KEY.
# SESSION_SECRET=

# Who may post reviews: anyone | owners | verified
#   owners   - blocks players Steam shows as not owning STS2; private game lists are allowed
#   verified - only players whose public game list shows STS2
REVIEW_OWNERSHIP=owners

# Slay the Spire 2's Steam app id. Workshop links for other games are rejected.
STS2_APP_ID=2868840
